.DS_Store

# Environment variables
frontend/.env
frontend/.env.production

# 배포 시크릿 (예시 *.example 만 커밋)
deploy/.env
deploy/backend-secrets.env
deploy/local/backend-secrets.local.env
deploy/local/tripcraft-images.tar.gz

# Local override configs
backend/src/main/resources/application-local.yml

# Frontend
frontend/node_modules/
frontend/dist/

.omc
.claude/worktrees/
frontend/pnpm-lock.yaml
frontend/pnpm-workspace.yaml

# IDE — 개인 메타데이터는 무시, 공유 실행구성(.run/)·VSCode 공유 3파일만 추적
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# Gradle 빌드 산출물
backend/build/
backend/.gradle/

# 로그 파일
*.log

# 업로드 파일 (로컬 저장소 — 운영환경에서는 별도 볼륨 마운트)
backend/uploads/

# 개인 스크래치 메모 (커밋 제외) — 커밋하는 기술 학습 문서는 docs/tech-notes/ 에 둘 것.
# 'notes' 디렉터리명만 무시하므로 docs/tech-notes/ 는 정상 추적된다.
notes/
