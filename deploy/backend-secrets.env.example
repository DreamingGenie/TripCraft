# 백엔드 시크릿 — 실제 값 채워 deploy/backend-secrets.env 로 복사 (git 커밋 금지)
# DB_* 는 compose 가 주입하므로 여기엔 불필요.

# ⚠ base64 여야 함 — 앱이 Decoders.BASE64.decode 로 해석(디코딩 시 32바이트↑ = HS256).
# 새로 생성: openssl rand -base64 48
JWT_SECRET=Y2hhbmdlLW1lLXJlcGxhY2Utd2l0aC1vcGVuc3NsLXJhbmQtYmFzZTY0LTQ4LWJ5dGVzLXZhbHVl

# 외부 API
TOUR_API_KEY=
ODSAY_API_KEY=
TMAP_API_KEY=
GMS_KEY=
GMS_BASE_URL=

# 카카오 (Redirect URI 는 콘솔 등록값·프론트와 일치)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=https://tripcraft.thdwjdrl.com/auth/kakao/callback
